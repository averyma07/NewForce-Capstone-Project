    <worksheet name='Posters Successful Movies'>
      <table>
        <view>
          <datasources>
            <datasource caption='TMDB_2D_Movies_Ani.csv (Multiple Connections)' name='federated.0yuxm9c0gcsr3f19sd31t1lib55j' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Number of Movies' caption='Map' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Number&quot;'>
              <calculation class='tableau' formula='&quot;Number&quot;' />
              <aliases>
                <alias key='&quot;Number&quot;' value='Number of Movies' />
                <alias key='&quot;Profit&quot;' value='Avg. Profit' />
                <alias key='&quot;Success&quot;' value='Most Successful Movie' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0yuxm9c0gcsr3f19sd31t1lib55j'>
            <column caption='Legend Filter Success' datatype='boolean' name='[Legend Filter Profit (copy)_0652010913595395]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] = &apos;Success&apos;' />
            </column>
            <column caption='Poster Filter Success' datatype='boolean' name='[Legend Filter Success (copy)_0530240048136194]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] = &apos;Success&apos; AND [name (country_codes.csv)] != &apos;All&apos;' />
            </column>
            <column caption='Poster Most Success' datatype='string' name='[Most Successful Movie Per Country (copy)_0530240038375424]' role='dimension' semantic-role='[URL]' type='nominal'>
              <calculation class='tableau' formula='{FIXED [name (country_codes.csv)]: MAX(IF [rev_bud_ratio] = { FIXED [name (country_codes.csv)]:MAX([rev_bud_ratio])} THEN [poster] END)}' />
            </column>
            <column caption='Animation Method Most Successful' datatype='string' name='[Ratio Over 2.5 (copy)_0085829714010115]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [name (country_codes.csv)]: MAX(IF [rev_bud_ratio] = { FIXED [name (country_codes.csv)]:MAX([rev_bud_ratio])} THEN (IF [Table Name] = &apos;TMDB_2D_Movies_Ani.csv&apos; THEN &apos;Traditional Animation&apos; ELSE &apos;Computer Animation&apos; END) END)}' />
            </column>
            <column datatype='string' name='[Table Name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;TMDB_2D_Movies_Ani.csv&quot;' value='Traditional Animation' />
                <alias key='&quot;TMDB_3D_Movies_Ani.csv&quot;' value='Computer Animation' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[name (country_codes.csv)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <semantic-values semantic-role='[Country].[Name]'>
                <semantic-value key='&quot;Netherlands, Kingdom of the&quot;' value='&quot;Netherlands&quot;' />
                <semantic-value key='&quot;Taiwan, Province of China&quot;' value='&quot;Taiwan&quot;' />
              </semantic-values>
            </column>
            <column-instance column='[Legend Filter Success (copy)_0530240048136194]' derivation='None' name='[none:Legend Filter Success (copy)_0530240048136194:nk]' pivot='key' type='nominal' />
            <column-instance column='[Most Successful Movie Per Country (copy)_0530240038375424]' derivation='None' name='[none:Most Successful Movie Per Country (copy)_0530240038375424:nk]' pivot='key' type='nominal' />
            <column-instance column='[name (country_codes.csv)]' derivation='None' name='[none:name (country_codes.csv):nk]' pivot='key' type='nominal' />
            <column caption='Poster' datatype='string' name='[poster]' role='dimension' semantic-role='[URL]' type='nominal' />
            <column caption='Rev Bud Ratio' datatype='real' name='[rev_bud_ratio]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0yuxm9c0gcsr3f19sd31t1lib55j].[Action (Legend Filter Success,Poster Filter Success,Animation Method Most Successful,Country)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action2_C8C95EC1E7F0488FBB7C95894D15DCD8]' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='empty-level' member='[Legend Filter Profit (copy)_0652010913595395]' />
              <groupfilter function='empty-level' member='[Legend Filter Success (copy)_0530240048136194]' />
              <groupfilter function='empty-level' member='[Ratio Over 2.5 (copy)_0085829714010115]' />
              <groupfilter function='empty-level' member='[name (country_codes.csv)]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0yuxm9c0gcsr3f19sd31t1lib55j].[none:Legend Filter Success (copy)_0530240048136194:nk]'>
