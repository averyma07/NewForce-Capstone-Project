      <column caption='genre pct' datatype='real' name='[Calculation_0368612552294408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNT([__tableau_internal_object_id__].[Genres_2D.csv_83112481F4B943138FE0E5E60D90FE93]) / TOTAL(COUNT([__tableau_internal_object_id__].[TMDB_2D_Movies_Ani.csv_21DC6D75125840F59DB1EA3E2EB8DE12])))'>
          <table-calc ordering-type='Rows' />
