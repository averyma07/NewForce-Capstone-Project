              <calculation class='tableau' formula='[Parameters].[Parameter 5]' />
            </column>
            <column caption='Most Successful Movie Per Country' datatype='string' name='[Calculation_0771374944870403]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [name (country_codes.csv)]: MAX(IF [rev_bud_ratio] = { FIXED [name (country_codes.csv)]:MAX([rev_bud_ratio])} THEN [title] END)}' />
            </column>
            <column caption='Legend Filter Success' datatype='boolean' name='[Legend Filter Profit (copy)_0652010913595395]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] = &apos;Success&apos;' />
            </column>
            <column caption='Poster Filter Success' datatype='boolean' name='[Legend Filter Success (copy)_0530240048136194]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] = &apos;Success&apos; AND [name (country_codes.csv)] != &apos;All&apos;' />
            </column>
            <column caption='Successful Movie Year' datatype='integer' name='[Most Successful Movie Per Country (copy)_0771374947766276]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [name (country_codes.csv)]: MAX(IF [rev_bud_ratio] = { FIXED [name (country_codes.csv)]:MAX([rev_bud_ratio])} THEN YEAR([release_date]) END)}' />
            </column>
            <column caption='Rev Bud Most Successful' datatype='real' name='[Ratio Over 2.5 (copy)_0085829712084994]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [name (country_codes.csv)]: MAX(IF [rev_bud_ratio] = { FIXED [name (country_codes.csv)]:MAX([rev_bud_ratio])} THEN [rev_bud_ratio] END)}' />
            </column>
            <column caption='Animation Method Most Successful' datatype='string' name='[Ratio Over 2.5 (copy)_0085829714010115]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [name (country_codes.csv)]: MAX(IF [rev_bud_ratio] = { FIXED [name (country_codes.csv)]:MAX([rev_bud_ratio])} THEN (IF [Table Name] = &apos;TMDB_2D_Movies_Ani.csv&apos; THEN &apos;Traditional Animation&apos; ELSE &apos;Computer Animation&apos; END) END)}' />
            </column>
            <column datatype='string' name='[Table Name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;TMDB_2D_Movies_Ani.csv&quot;' value='Traditional Animation' />
                <alias key='&quot;TMDB_3D_Movies_Ani.csv&quot;' value='Computer Animation' />
              </aliases>
