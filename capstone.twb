          <datasource-dependencies datasource='federated.0yuxm9c0gcsr3f19sd31t1lib55j'>
            <column caption='Poster Best Rated Movie Acted' datatype='string' name='[Best Rated Movie Acted (copy)_0530240063324163]' role='dimension' semantic-role='[URL]' type='nominal'>
              <calculation class='tableau' formula='{FIXED [name]: MAX(IF [vote_average] = { FIXED [name]:MAX([vote_average])} THEN [poster] END)}' />
