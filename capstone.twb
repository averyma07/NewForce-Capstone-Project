      <table>
        <view>
          <datasources>
            <datasource caption='TMDB_2D_Movies_Ani.csv (Multiple Connections)' name='federated.0yuxm9c0gcsr3f19sd31t1lib55j' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Number of Movies' caption='Map' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Number&quot;'>
              <calculation class='tableau' formula='&quot;Number&quot;' />
              <aliases>
                <alias key='&quot;Number&quot;' value='Number of Movies' />
                <alias key='&quot;Profit&quot;' value='Avg. Profit' />
                <alias key='&quot;Success&quot;' value='Most Successful Movie' />
              </aliases>
            </column>
          </datasource-dependencies>
