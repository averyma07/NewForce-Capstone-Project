      </column>
      <column caption='Runtime Filter' datatype='boolean' name='[Calculation_0085829724262404]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = 0 THEN [runtime] &gt;= 70&#13;&#10;ELSEIF [Parameters].[Parameter 2] = 1 THEN [runtime] &lt; 70&#13;&#10;ELSE TRUE END' />
