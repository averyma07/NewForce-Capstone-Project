          <filter class='categorical' column='[federated.0yuxm9c0gcsr3f19sd31t1lib55j].[none:name (country_codes.csv):nk]' filter-group='5'>
            <groupfilter expression='MAX([rev_bud_ratio]) &gt; 0.' function='filter' user:ui-filter-by-field='true' user:ui-marker='filter-by'>
